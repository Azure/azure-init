ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 libudev1 \
    && rm -rf /var/lib/apt/lists \
    && mkdir -p /test /work /var/lib/hyperv /etc/sudoers.d \
    && touch /test/isolated-provisioning

COPY testing-server/container_provisioning.py testing-server/imds_handler.py \
    testing-server/wireserver_handler.py testing-server/utils.py /test/

ENTRYPOINT ["python3", "-B", "/test/container_provisioning.py", "--inside"]
